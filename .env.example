# Application Runtime
APP_ENV=development
APP_NAME="CODGuard API"

# Database Configuration (PostgreSQL 16)
# Local development default:
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/codguard
# Docker Compose internal URL:
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/codguard
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=codguard

# Security & Authentication
# Replace with a secure 32+ character random string in production
JWT_SECRET_KEY=change-this-in-production-secret-key-32chars

# AI & Integrations (Leave empty for Prompt 1)
LLM_API_KEY=
TELEGRAM_BOT_TOKEN=

# Frontend Configuration
FRONTEND_URL=http://localhost:5173
VITE_API_URL=http://localhost:8000
